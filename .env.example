# TimeSeries Studio AI — example environment configuration
# Copy this file to `.env` and adjust as needed.
# Everything in this project runs locally by default — these are optional
# overrides, not required credentials.

# Default forecast horizon (steps) used by forecast_cli.py if --horizon is omitted
DEFAULT_HORIZON=30

# Default frequency for resampling (D, W, M, H)
DEFAULT_FREQ=D

# Which models to run by default in the CLI (comma-separated)
DEFAULT_MODELS=ARIMA,XGBoost

# Directory where uploaded/sample data is expected (used by --folder ingestion)
DATA_DIR=data/

# Directory where CLI forecast CSVs are written
OUTPUT_DIR=.

# Streamlit server settings (optional — Streamlit also reads .streamlit/config.toml)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
